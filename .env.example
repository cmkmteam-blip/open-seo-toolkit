# Everything is optional. The toolkit works with no environment variables at all.

# Enables the optional "AI keyword ideas" panel in the Keyword Mixer.
# Get a key at https://aistudio.google.com/apikey. Leave empty to hide the feature.
GEMINI_API_KEY=
# Optional model override for the AI keyword ideas.
GEMINI_MODEL=

# Site crawler limits (defaults: 100 pages max, 500 ms delay between requests).
CRAWL_MAX_PAGES=
CRAWL_MIN_DELAY_MS=
# Set to true ONLY for local development to crawl localhost / LAN sites. Never on a public deployment.
ALLOW_PRIVATE_HOSTS=
